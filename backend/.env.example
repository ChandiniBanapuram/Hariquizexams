# Port that the express server runs on
# Hugging Face Spaces uses 7860, Render uses dynamic PORT
PORT=7860

# CORS settings - set this to your Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app

# ── TiDB Cloud Serverless (Free) ──────────────────────────────
# DB_TYPE must be 'tidb' for TiDB Cloud, 'aiven' for Aiven MySQL
DB_TYPE=tidb
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=3DM63qZZBunmFDk.root
DB_PASSWORD=your-tidb-password
DB_NAME=exam_db
DB_SSL=true

# JWT settings
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Brevo (Sendinblue) settings for forgot-password OTP emails
BREVO_API_KEY=xkeysib-xxxxxxxxx-xxxxxxxxx
BREVO_SENDER_EMAIL=noreply@examportal.com

# Code Execution Engine Strategy
EXECUTION_STRATEGY=judge0
